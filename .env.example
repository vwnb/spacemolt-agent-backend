# SpaceMolt API (optional)
SPACEMOLT_BASE_URL=https://game.spacemolt.com/api/v2

# Browser origin allowed to call the API (optional; exact match)
ALLOWED_ORIGIN=

# LLM picker (recommended: openrouter free models)
LLM_PROVIDER=openrouter
# For openrouter: set OPENROUTER_API_KEY; LLM_BASE_URL defaults to https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
# For opper: set OPPER_API_KEY; defaults to https://api.opper.ai/v3/compat
OPPER_API_KEY=
# For openapi: set LLM_BASE_URL + LLM_API_KEY
LLM_BASE_URL=
LLM_API_KEY=
# Pick any model id; for openrouter free models see /api/health or src/reasoning/models.ts
LLM_MODEL=nvidia/nemotron-3.5-super-vl:free
LLM_TIMEOUT_MS=30000
# Optional JSON object merged as headers
LLM_EXTRA_HEADERS_JSON=

# Ops
LOG_LEVEL=info
